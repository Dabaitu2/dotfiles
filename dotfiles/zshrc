# direnv to automatically activate venv packages - optimized loading
# Load direnv asynchronously to speed up shell startup
eval "$(direnv hook zsh)"

# Optimize direnv performance
if [[ -z "$DIRENV_NO_SKIP_HOME" ]]; then
  # Skip home directory to avoid unnecessary checks
  # Initialize DIRENV_WATCHES if not set
  if [[ -z "${DIRENV_WATCHES+set}" ]]; then
    export DIRENV_WATCHES=()
  fi
  export DIRENV_WATCHES=(
    "${DIRENV_WATCHES[@]}"
    -~ # Exclude home directory
  )
fi

# Reduce direnv verbosity and disable debug output
export DIRENV_LOG_FORMAT=""

# Cache environment variables for 5 minutes to reduce reloads
export DIRENV_CACHE_TIME=300

